#!/bin/sh
set -eu

data_dir=/var/lib/tidetracker
role_file=/etc/tidetracker/role
key_file=/etc/tidetracker/provision-authorized-key
marker="$data_dir/provisioned"
pending="$data_dir/provisioning-pending"

validate_role_file() {
    path=$1
    description=$2
    test -f "$path" && test ! -L "$path" && test "$(cat "$path")" = "$role" || {
        echo "$description is invalid" >&2
        exit 1
    }
}

atomic_role_file() {
    path=$1
    mode=$2
    python3 - "$path" "$mode" "$role" <<'PY'
import os
import stat
import sys

path, mode_text, role = sys.argv[1:]
directory = os.path.dirname(path)
if os.path.lexists(path):
    current = os.lstat(path)
    if not stat.S_ISREG(current.st_mode):
        raise SystemExit(f"refusing to replace non-regular marker: {path}")
temporary = os.path.join(directory, f".{os.path.basename(path)}.tidetracker.tmp")
if os.path.lexists(temporary):
    current = os.lstat(temporary)
    if (
        not stat.S_ISREG(current.st_mode)
        or stat.S_IMODE(current.st_mode) != 0o600
        or current.st_uid != 0
    ):
        raise SystemExit(f"refusing unsafe interrupted marker temp: {temporary}")
    os.unlink(temporary)
    directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
fd = os.open(
    temporary,
    os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
    0o600,
)
try:
    os.fchmod(fd, int(mode_text, 8))
    os.fchown(fd, 0, 0)
    payload = (role + "\n").encode("ascii")
    written = 0
    while written < len(payload):
        count = os.write(fd, payload[written:])
        if count <= 0:
            raise OSError("short marker write")
        written += count
    os.fsync(fd)
    os.close(fd)
    fd = -1
    os.replace(temporary, path)
    directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
finally:
    if fd >= 0:
        os.close(fd)
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    else:
        directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
PY
}

durable_remove() {
    path=$1
    python3 - "$path" <<'PY'
import os
import sys

path = sys.argv[1]
directory = os.path.dirname(path)
try:
    os.unlink(path)
except FileNotFoundError:
    pass
directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)
PY
}

test "$(id -u)" -eq 0
test -s "$role_file"
test -d "$data_dir"

role=$(cat "$role_file")
case "$role" in controller|zero) ;; *) echo "Invalid TideTracker role: $role" >&2; exit 2 ;; esac
if test "$role" = zero; then
    expected_data_uuid=54540000-0000-4000-8000-000000000002
else
    expected_data_uuid=54540000-0000-4000-8000-000000000001
fi
test "$(findmnt -n -o UUID --target "$data_dir" 2>/dev/null || true)" = "$expected_data_uuid" || {
    echo 'role-specific TIDEDATA UUID is not mounted; refusing to provision the overlay root' >&2
    exit 1
}
test "$(findmnt -n -o FSTYPE --target "$data_dir" 2>/dev/null || true)" = ext4 || {
    echo 'TIDEDATA is not the required ext4 filesystem' >&2
    exit 1
}
case ",$(findmnt -n -o OPTIONS --target "$data_dir" 2>/dev/null || true)," in
    *,rw,*) ;;
    *) echo 'TIDEDATA is not mounted read-write' >&2; exit 1 ;;
esac

validate_overlay_state() {
    test "$(findmnt -n -o FSTYPE --target / 2>/dev/null || true)" = overlay || {
        echo 'root filesystem is not the required overlay after reboot' >&2; exit 1;
    }
    grep -Eq '(^|[[:space:]])overlayroot=tmpfs:recurse=0([[:space:]]|$)' /proc/cmdline || {
        echo 'kernel command line does not preserve writable non-root filesystems' >&2; exit 1;
    }
    test "$(awk '{ count=0; for (i=1; i<=NF; i++) if ($i ~ /^overlayroot=/) count++; print count }' /proc/cmdline)" -eq 1 || {
        echo 'kernel command line must contain exactly one overlayroot option' >&2; exit 1;
    }
    grep -Fx 'overlayroot=""' /etc/overlayroot.conf >/dev/null || {
        echo 'overlayroot configuration must remain non-activating' >&2; exit 1;
    }
    test "$(findmnt -n -o FSTYPE --target /media/root-ro 2>/dev/null || true)" = ext4 || {
        echo 'overlay lower root is not the expected ext4 filesystem' >&2; exit 1;
    }
    case ",$(findmnt -n -o OPTIONS --target /media/root-ro 2>/dev/null || true)," in
        *,ro,*) ;;
        *) echo 'overlay lower root is not mounted read-only' >&2; exit 1 ;;
    esac
    boot_target=/boot/firmware
    mountpoint -q "$boot_target" || boot_target=/boot
    mountpoint -q "$boot_target" || {
        echo 'boot filesystem is not mounted' >&2; exit 1;
    }
    case ",$(findmnt -n -o OPTIONS --target "$boot_target" 2>/dev/null || true)," in
        *,ro,*) ;;
        *) echo 'boot filesystem is not mounted read-only' >&2; exit 1 ;;
    esac
    test "$(findmnt -n -o UUID --target /etc/NetworkManager/system-connections 2>/dev/null || true)" = \
        "$expected_data_uuid" || {
        echo 'NetworkManager profile bind is not sourced from TIDEDATA' >&2; exit 1;
    }
    test "$(findmnt -n -o FSROOT --target /etc/NetworkManager/system-connections 2>/dev/null || true)" = \
        /networkmanager || {
        echo 'NetworkManager profile bind has the wrong TIDEDATA subdirectory' >&2; exit 1;
    }
}

if test -e "$marker"; then
    validate_role_file "$marker" 'first-boot completion marker'
    validate_overlay_state
    if test -e "$pending"; then
        validate_role_file "$pending" 'first-boot pending marker'
        durable_remove "$pending"
    fi
    exit 0
fi

if test -e "$pending" &&
    test "$(findmnt -n -o FSTYPE --target / 2>/dev/null || true)" != overlay; then
    validate_role_file "$pending" 'first-boot pending marker'
    test "$(findmnt -n -o FSTYPE --target / 2>/dev/null || true)" = ext4 || {
        echo 'first-boot resume requires the original ext4 root' >&2; exit 1;
    }
    # Overlay activation did not survive the interrupted boot. Retire this
    # attempt durably and repeat the idempotent lower-root setup below.
    durable_remove "$pending"
fi

if test -e "$pending"; then
    validate_role_file "$pending" 'first-boot pending marker'
    validate_overlay_state
    atomic_role_file "$marker" 0640
    durable_remove "$pending"
    exit 0
fi

test -x /usr/bin/resolvectl
systemctl is-enabled --quiet systemd-resolved.service
test "$(readlink /etc/resolv.conf)" = /run/systemd/resolve/stub-resolv.conf
grep -Eq '^[[:space:]]*dns=systemd-resolved[[:space:]]*$' \
    /etc/NetworkManager/conf.d/10-tidetracker-resolved.conf
test "$(awk 'NR > 1 { count += 1 } END { print count + 0 }' /proc/swaps)" -eq 0 || {
    echo 'swap is active; refusing TideTracker provisioning' >&2; exit 1;
}

if test ! -s /etc/machine-id; then
    systemd-machine-id-setup
fi
ssh-keygen -A

if ! id tidetracker >/dev/null 2>&1; then
    useradd --create-home --user-group --shell /bin/bash tidetracker
fi
# Repair every account attribute on a resumed attempt. `NP` is deliberately not
# a valid crypt hash and has no leading lock marker that could reject SSH keys.
usermod --home /home/tidetracker --shell /bin/bash --expiredate '' --password NP tidetracker
install -d -m 0750 -o tidetracker -g tidetracker /home/tidetracker
groups=
if test "$role" = controller; then
    groups='dialout video'
fi
for group in $groups; do
    getent group "$group" >/dev/null 2>&1 && usermod -a -G "$group" tidetracker
done

test -s "$key_file" || { echo 'provisioned SSH authorized key is unavailable' >&2; exit 1; }
PYTHONPATH=/usr/local/lib/tidetracker/app /usr/bin/python3 - "$role" "$key_file" <<'PY'
import hashlib
import json
import pathlib
import stat
import sys

from tidetracker.key_policy import (
    KeyPolicyError,
    build_key_policy,
    openssh_ed25519_der,
    read_public_key,
    validate_key_policy,
)

role, key_text = sys.argv[1:]
key_path = pathlib.Path(key_text)
policy_path = pathlib.Path("/etc/tidetracker/key-policy.json")
policy_hash_path = pathlib.Path("/etc/tidetracker/key-policy.sha256")
public_key_paths = {
    "workstation_to_controller_ssh": pathlib.Path(
        "/etc/tidetracker/workstation-controller-ssh.pub"
    ),
    "controller_to_zero_ssh": pathlib.Path("/etc/tidetracker/controller-zero-ssh.pub"),
    "application_release": pathlib.Path("/etc/tidetracker/release-ed25519.pub.pem"),
    "lab_safety": pathlib.Path("/etc/tidetracker/lab-safety-approver.pub.pem"),
    "image_release": pathlib.Path("/etc/tidetracker/image-release-ed25519.pub.pem"),
}
for path, mode, label in (
    (key_path, 0o600, "provisioned authorized key"),
    (policy_path, 0o644, "key policy"),
    (policy_hash_path, 0o644, "key-policy digest"),
    *((path, 0o644, f"{name} public key") for name, path in public_key_paths.items()),
):
    metadata = path.lstat()
    if (
        path.is_symlink()
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != 0
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        raise SystemExit(f"{label} has unsafe ownership, mode, or file type")


def reject_duplicates(items: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for name, value in items:
        if name in result:
            raise ValueError(f"duplicate key-policy field: {name}")
        result[name] = value
    return result


try:
    policy = validate_key_policy(
        json.loads(policy_path.read_text(encoding="utf-8"), object_pairs_hook=reject_duplicates)
    )
    public_keys = {
        name: read_public_key(path, f"{name} public key")
        for name, path in public_key_paths.items()
    }
    reconstructed_policy = build_key_policy(**public_keys)
    key = read_public_key(key_path, "provisioned authorized key")
    canonical = openssh_ed25519_der(key, "provisioned authorized key")
    policy_hash = policy_hash_path.read_text(encoding="ascii").strip()
except (OSError, UnicodeError, ValueError, KeyPolicyError) as exc:
    raise SystemExit("installed five-key policy is invalid") from exc
prefix = (
    "workstation_to_controller_ssh" if role == "controller" else "controller_to_zero_ssh"
)
if (
    policy_hash != policy["key_policy_sha256"]
    or policy != reconstructed_policy
    or hashlib.sha256(key).hexdigest() != policy[f"{prefix}_public_key_sha256"]
    or hashlib.sha256(canonical).hexdigest() != policy[f"{prefix}_key_material_sha256"]
):
    raise SystemExit("role-authorized SSH key does not match the installed five-key policy")
PY
ssh-keygen -l -f "$key_file" >/dev/null
install -d -m 0700 -o tidetracker -g tidetracker /home/tidetracker/.ssh
install -m 0600 -o tidetracker -g tidetracker "$key_file" /home/tidetracker/.ssh/authorized_keys
sshd -t

install -d -m 0750 -o root -g root \
    "$data_dir/config" "$data_dir/incoming" "$data_dir/releases" \
    "$data_dir/results" "$data_dir/state" "$data_dir/telemetry"
install -d -m 0750 -o tidetracker -g tidetracker "$data_dir/uploads"
install -d -m 0700 -o root -g root "$data_dir/networkmanager"
install -d -m 0700 -o root -g root "$data_dir/state/hil"
if test "$role" = controller; then
    install -d -m 0750 -o root -g tidetracker "$data_dir/controller"
    install -d -m 0770 -o root -g tidetracker "$data_dir/controller/hil-results"
    # The controller-to-Zero automation identity is the only private key that
    # belongs on either Pi.  Create its persistent root-only TIDEDATA location,
    # but never generate or copy key material during image provisioning.
    install -d -m 0700 -o root -g root "$data_dir/controller/ssh"
    touch "$data_dir/controller/hil.lock"
    chown root:tidetracker "$data_dir/controller/hil.lock"
    chmod 0660 "$data_dir/controller/hil.lock"
fi
chown -R root:root "$data_dir/config" "$data_dir/incoming" "$data_dir/releases" \
    "$data_dir/results" "$data_dir/state" "$data_dir/telemetry"
chown -R tidetracker:tidetracker "$data_dir/uploads"
find "$data_dir" -xdev -type d -exec chmod o-rwx {} +
find "$data_dir/config" -xdev -type f -exec chmod 0600 {} +

# The pending marker is durable before any boot configuration changes. If power
# fails before the final cmdline rename, the next ext4 boot safely retries.
sync
atomic_role_file "$pending" 0600

test "$(dpkg-query -W -f='${db:Status-Status}' overlayroot 2>/dev/null || true)" = installed || {
    echo 'offline-provisioned overlayroot package is unavailable' >&2; exit 1;
}
boot_target=/boot/firmware
mountpoint -q "$boot_target" || boot_target=/boot
mountpoint -q "$boot_target" || { echo 'boot filesystem is not mounted' >&2; exit 1; }
boot_cmdline="$boot_target/cmdline.txt"
test -f "$boot_cmdline" || { echo 'boot command line is unavailable' >&2; exit 1; }
case ",$(findmnt -n -o OPTIONS --target "$boot_target" 2>/dev/null || true)," in
    *,ro,*) mount -o remount,rw "$boot_target" ;;
esac

# The application helper leaves overlayroot.conf explicitly disabled and makes
# the final kernel command-line rename the sole activation commit point.
/usr/bin/python3 /usr/local/lib/tidetracker/app/tidetracker/firstboot_overlay.py \
    /etc/fstab /etc/overlayroot.conf "$boot_cmdline"

sync
mount -o remount,ro "$boot_target"

touch /run/tidetracker-firstboot-reboot
sync
systemctl --no-block reboot
