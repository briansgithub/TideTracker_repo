[Unit]
Description=TideTracker wireless setup portal
After=local-fs.target NetworkManager.service tidetracker-firstboot.service tidetracker-usb-firewall.service
Requires=NetworkManager.service
Requires=tidetracker-firstboot.service tidetracker-usb-firewall.service
Conflicts=tidetracker-cycle.service
ConditionPathIsExecutable=/usr/local/bin/tidetracker
ConditionPathExists=/var/lib/tidetracker/provisioned
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/tidetracker/runtime.env
RuntimeDirectory=tidetracker-portal
RuntimeDirectoryMode=0750
ExecCondition=/bin/sh -c 'test -f /var/lib/tidetracker/provisioned && test ! -L /var/lib/tidetracker/provisioned && test "$(cat /var/lib/tidetracker/provisioned)" = zero'
ExecStart=/usr/local/bin/tidetracker portal
TimeoutStartSec=30
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
UMask=0077
PrivateTmp=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/tidetracker /etc/NetworkManager/system-connections /run
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
