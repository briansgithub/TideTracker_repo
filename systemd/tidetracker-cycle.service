[Unit]
Description=TideTracker bounded wake cycle
After=local-fs.target NetworkManager.service systemd-timesyncd.service systemd-resolved.service tidetracker-firstboot.service tidetracker-usb-firewall.service dev-spidev0.0.device
Wants=NetworkManager.service systemd-timesyncd.service
Requires=tidetracker-firstboot.service tidetracker-usb-firewall.service systemd-resolved.service
OnFailure=tidetracker-failsafe.service
Conflicts=tidetracker-portal.service
ConditionPathIsExecutable=/usr/local/bin/tidetracker
ConditionPathExists=/var/lib/tidetracker/provisioned

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/tidetracker/runtime.env
Environment=HOME=/run/tidetracker
Environment=MPLCONFIGDIR=/run/tidetracker/matplotlib
RuntimeDirectory=tidetracker
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecCondition=/bin/sh -c 'test ! -e /run/tidetracker-firstboot-reboot'
ExecCondition=/bin/sh -c 'test -f /var/lib/tidetracker/provisioned && test ! -L /var/lib/tidetracker/provisioned && test "$(cat /var/lib/tidetracker/provisioned)" = zero'
ExecStart=/usr/local/bin/tidetracker cycle --service
# Mode-aware trials are bounded at 210 s RUN / 930 s SETUP. Preserve a full
# 900 s setup fallback plus 90 s for persistence, evidence, DONE, and teardown.
TimeoutStartSec=1920
TimeoutStopSec=10
KillSignal=SIGTERM
Restart=no
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/tidetracker /etc/NetworkManager/system-connections /run/tidetracker
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_SYS_TIME
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_SYS_TIME

[Install]
WantedBy=multi-user.target
